<UserControl x:Class="SyncPulse.Client.Views.MainChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="Segoe UI">

    <Grid Background="#F8FAFC">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" MinWidth="280" MaxWidth="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ========================================================================= -->
        <!-- 1. الشريط الجانبي (Sidebar: User Profile & Search & Contacts List)          -->
        <!-- ========================================================================= -->
        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- أ. ترويسة المستخدم الحالي مع أزرار سجل المكالمات والخروج -->
                <Border Grid.Row="0" Background="#F1F5F9" Padding="14,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- أفاتار المستخدم الحالي -->
                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="#2563EB" Margin="0,0,10,0">
                            <TextBlock Text="{Binding UserInitial}" Foreground="White" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- بيانات المستخدم الحالي -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentDisplayName}" FontWeight="Bold" FontSize="13.5" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding CurrentUsername, StringFormat='{}@{0}'}" FontSize="11.5" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- أزرار سجل المكالمات والخروج -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="📞 السجل" Command="{Binding ToggleCallHistoryCommand}"
                                    Background="#EFF6FF" Foreground="#2563EB" BorderBrush="#BFDBFE" BorderThickness="1"
                                    FontSize="11" FontWeight="Bold" Padding="7,4" Margin="0,0,4,0" Cursor="Hand" ToolTip="سجل المكالمات">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6" />
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Content="خروج" Command="{Binding LogoutCommand}"
                                    Background="#FEE2E2" Foreground="#DC2626" BorderBrush="#FECDD3" BorderThickness="1"
                                    FontSize="11" FontWeight="SemiBold" Padding="7,4" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6" />
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ب. حقل البحث والإضافة باسم المستخدم (@username) -->
                <Border Grid.Row="1" Padding="14,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1"
                                     Padding="10,7" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8" />
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="بحث" Command="{Binding SearchContactCommand}"
                                        Background="#EFF6FF" Foreground="#2563EB" BorderBrush="#BFDBFE" BorderThickness="1"
                                        FontSize="11.5" FontWeight="Bold" Padding="10,6" Margin="0,0,4,0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                                <Button Content="إضافة +" Command="{Binding AddContactCommand}"
                                        Background="#2563EB" Foreground="White" BorderThickness="0"
                                        FontSize="11.5" FontWeight="Bold" Padding="10,6" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- شريط نتائج البحث -->
                        <Border Background="#F0FDF4" CornerRadius="6" BorderBrush="#BBF7D0" BorderThickness="1" Padding="8,4" Margin="0,8,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSearchResult}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding SearchResultText}" Foreground="#15803D" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ج. قائمة جهات الاتصال أو درج سجل المكالمات -->
                <Grid Grid.Row="2">
                    <!-- 1. قائمة جهات الاتصال الافتراضية -->
                    <ListBox ItemsSource="{Binding Contacts}" SelectedItem="{Binding SelectedContact}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="6,3" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu FlowDirection="RightToLeft">
                                            <MenuItem Header="📞 اتصال صوتي" Command="{Binding DataContext.StartAudioCallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            <MenuItem Header="📹 مكالمة فيديو" Command="{Binding DataContext.StartVideoCallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            <Separator />
                                            <MenuItem Header="🗑️ حذف من جهات الاتصال" Command="{Binding DataContext.DeleteContactCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Foreground="#DC2626" />
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="10" Padding="12,10">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#EFF6FF" />
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#BFDBFE" />
                                                    <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#F8FAFC" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- أفاتار جهة الاتصال مع نقطة الحالة -->
                                    <Grid Grid.Column="0" Margin="0,0,10,0">
                                        <Border Width="42" Height="42" CornerRadius="21" Background="{Binding AvatarBackground}">
                                            <TextBlock Text="{Binding InitialChar}" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Width="12" Height="12" CornerRadius="6" Background="{Binding StatusColor}" BorderBrush="White" BorderThickness="2"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                    </Grid>

                                    <!-- اسم جهة الاتصال والقصاصة اللحظية -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DisplaySnippet}" FontSize="11.5" Foreground="{Binding StatusColor}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- الوقت والرسائل غير المقروءة -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding FormattedTime}" FontSize="10.5" Foreground="#94A3B8" HorizontalAlignment="Right" />
                                        <Border Background="#2563EB" CornerRadius="8" Padding="6,2" Margin="0,4,0,0" HorizontalAlignment="Right">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasUnread}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding UnreadCount}" Foreground="White" FontSize="10" FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 2. درج سجل المكالمات (Call History Overlay Drawer) -->
                    <Border Background="#FFFFFF" Padding="8,10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCallHistoryOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="6,0,6,8">
                                <TextBlock Text="📞 سجل المكالمات السابقة" FontSize="13" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" />
                                <Button Content="✕ إغلاق" Command="{Binding ToggleCallHistoryCommand}"
                                        Background="#F1F5F9" Foreground="#64748B" FontSize="11" Padding="6,2" HorizontalAlignment="Left" Cursor="Hand" BorderThickness="0">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>

                            <ListBox Grid.Row="1" ItemsSource="{Binding CallHistory}" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10,8" Margin="0,3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding TypeIcon}" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TargetPartyName}" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A" />
                                                    <TextBlock Text="{Binding FormattedTime}" FontSize="10" Foreground="#64748B" Margin="0,2,0,0" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DirectionIcon}" FontSize="10.5" FontWeight="SemiBold" Foreground="#2563EB" HorizontalAlignment="Right" />
                                                    <TextBlock Text="{Binding DurationFormatted, StringFormat='{}⏱ {0}'}" FontSize="10" Foreground="#059669" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- 2. منطقة المحادثة النشطة (Active Chat Area & Message Stream)                -->
        <!-- ========================================================================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- أ. ترويسة المحادثة النشطة مع أزرار الاتصال ومسح السجل -->
            <Border Grid.Row="0" Background="#FFFFFF" Padding="18,14" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- بيانات جهة الاتصال النشطة ومؤشر يكتب الآن -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedContactTitle}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" />
                        <TextBlock Text="{Binding SelectedContact.StatusText}" FontSize="11.5" Foreground="{Binding SelectedContact.StatusColor}" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- أزرار المكالمات الصوتية والمرئية ومسح المحادثة -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedContact}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- زر مكالمة صوتية -->
                        <Button Content="📞 اتصال صوتي" Command="{Binding StartAudioCallCommand}"
                                Background="#ECFDF5" Foreground="#059669" BorderBrush="#A7F3D0" BorderThickness="1"
                                FontWeight="Bold" FontSize="12" Padding="12,7" Margin="0,0,6,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- زر مكالمة فيديو -->
                        <Button Content="📹 مكالمة فيديو" Command="{Binding StartVideoCallCommand}"
                                Background="#EFF6FF" Foreground="#2563EB" BorderBrush="#BFDBFE" BorderThickness="1"
                                FontWeight="Bold" FontSize="12" Padding="12,7" Margin="0,0,6,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- زر مسح المحادثة -->
                        <Button Content="مسح السجل" Command="{Binding ClearChatHistoryCommand}"
                                Background="#F8FAFC" Foreground="#64748B" BorderBrush="#E2E8F0" BorderThickness="1"
                                FontSize="11.5" FontWeight="SemiBold" Padding="10,7" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ب. شريط إعلانات النظام العامة (System Broadcast Alert Bar) -->
            <Border Grid.Row="1" Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="0,0,0,1" Padding="14,8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSystemAnnouncement}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding SystemAnnouncement}" Foreground="#B45309" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="✕" Command="{Binding DismissAnnouncementCommand}"
                            Background="Transparent" Foreground="#B45309" FontWeight="Bold" FontSize="13" BorderThickness="0" Cursor="Hand" />
                </Grid>
            </Border>

            <!-- ج. دفق الرسائل وفقاعات المحادثة مع دعم نقل وحفظ الملفات الفعلي (Message Bubbles & Files) -->
            <ScrollViewer Grid.Row="2" Background="#F8FAFC" Padding="18,14" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Border CornerRadius="12" Padding="14,10" MaxWidth="520"
                                        Background="{Binding BubbleBackground}" BorderBrush="{Binding BubbleBorder}" BorderThickness="1"
                                        HorizontalAlignment="{Binding Alignment}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="8" Direction="270" ShadowDepth="2" Opacity="0.04" Color="#0F172A" />
                                    </Border.Effect>

                                    <StackPanel>
                                        <!-- 1. صورة تليجرام المباشرة (Telegram-Style Inline Image) -->
                                        <Border CornerRadius="10" ClipToBounds="True" MaxWidth="360" Margin="0,0,0,6" Cursor="Hand">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsImageAttachment}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Image Source="{Binding ImagePreviewSource}" Stretch="Uniform" MaxHeight="260" />
                                                <!-- زر شفاف لفتح الصورة بالحجم الكامل عند النقر -->
                                                <Button Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Opacity="0" Cursor="Hand" Background="Transparent" BorderThickness="0" />
                                            </Grid>
                                        </Border>

                                        <!-- 2. بطاقة المقطع الصوتي بنمط تليجرام (Telegram-Style Audio Player Card) -->
                                        <Border Background="#F1F5F9" CornerRadius="10" Padding="10,8" Margin="0,0,0,6" BorderBrush="#E2E8F0" BorderThickness="1" MinWidth="240">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAudioAttachment}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- زر التشغيل الدائري -->
                                                <Button Grid.Column="0" Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Width="36" Height="36" Background="#2563EB" Foreground="White"
                                                        FontSize="13" FontWeight="Bold" Content="▶" Cursor="Hand" BorderThickness="0" Margin="0,0,10,0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="18" />
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>

                                                <!-- اسم المقطع وحجمه -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayFileName}" FontSize="12" FontWeight="Bold" Foreground="#1E293B" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding FormattedSize}" FontSize="10.5" Foreground="#64748B" Margin="0,2,0,0" />
                                                </StackPanel>

                                                <!-- زر الحفظ -->
                                                <Button Grid.Column="2" Content="💾" Command="{Binding DataContext.SaveFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Background="#E2E8F0" Foreground="#1E293B" FontSize="12" Padding="6,4" Cursor="Hand" BorderThickness="0">
                                                    <Button.Resources>
                                                        <Style TargetType="Border">
                                                            <Setter Property="CornerRadius" Value="6" />
                                                        </Style>
                                                    </Button.Resources>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <!-- 3. بطاقة الملفات والمستندات (Telegram-Style Document Card) -->
                                        <Border Background="#F1F5F9" CornerRadius="10" Padding="10,8" Margin="0,0,0,6" BorderBrush="#E2E8F0" BorderThickness="1" MinWidth="220">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGeneralFile}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- أيقونة الملف -->
                                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#DBEAFE" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding FileIcon}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <!-- اسم وحجم الملف -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayFileName}" FontSize="12" FontWeight="Bold" Foreground="#1E293B" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding FormattedSize}" FontSize="10.5" Foreground="#64748B" Margin="0,2,0,0" />
                                                </StackPanel>

                                                <!-- أزرار الفتح والحفظ -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="📂" Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Background="#2563EB" Foreground="White" FontSize="11" Padding="7,4" Margin="0,0,4,0" Cursor="Hand" BorderThickness="0">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="6" />
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                    <Button Content="💾" Command="{Binding DataContext.SaveFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Background="#059669" Foreground="White" FontSize="11" Padding="7,4" Cursor="Hand" BorderThickness="0">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="6" />
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- 4. نص الرسالة أو التعليق المرفق (Message Text / Caption) -->
                                        <TextBlock Text="{Binding Content}" Foreground="{Binding TextColor}" FontSize="13.5" TextWrapping="Wrap" LineHeight="20">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasTextContent}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- 5. الوقت وعلامات الصح ✓/✓✓ -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding FormattedTime}" FontSize="10" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding StatusIcon}" FontSize="11" FontWeight="Bold" Foreground="{Binding StatusColor}" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOutgoing}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- د. شريط إدخال وإرسال الرسالة مع زر إرفاق الملفات 📎 -->
            <Border Grid.Row="3" Background="#FFFFFF" Padding="16,12" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- زر إرفاق الملفات والمستندات والصور 📎 -->
                    <Button Grid.Column="0" Content="📎" Command="{Binding AttachFileCommand}"
                            Width="42" Height="42" Background="#F1F5F9" Foreground="#2563EB" BorderBrush="#CBD5E1" BorderThickness="1"
                            FontSize="18" FontWeight="Bold" Cursor="Hand" Margin="0,0,10,0" ToolTip="إرفاق ونقل ملف أو صورة">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10" />
                            </Style>
                        </Button.Resources>
                    </Button>

                    <!-- صندوق كتابة الرسالة -->
                    <TextBox Grid.Column="1" Text="{Binding InputMessage, UpdateSourceTrigger=PropertyChanged}"
                             Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1"
                             Padding="12,10" FontSize="13.5" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10" />
                            </Style>
                        </TextBox.Resources>
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SendMessageCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <!-- زر الإرسال الأزرق الملكي -->
                    <Button Grid.Column="2" Content="إرسال ✈" Command="{Binding SendMessageCommand}"
                            Height="42" Foreground="White" FontWeight="Bold" FontSize="13" Padding="20,0" Cursor="Hand" BorderThickness="0">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2563EB" Offset="0" />
                                <GradientStop Color="#0284C7" Offset="1" />
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="2" Opacity="0.2" Color="#2563EB" />
                                    </Border.Effect>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
