<UserControl x:Class="SyncPulse.Client.Views.AuthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             FontFamily="Segoe UI">

    <Grid Background="#F8FAFC">
        <!-- الحاوية المركزية للبطاقة -->
        <Border Background="#FFFFFF" CornerRadius="18" BorderBrush="#E2E8F0" BorderThickness="1"
                Width="420" Padding="32,28" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" Direction="270" ShadowDepth="6" Opacity="0.08" Color="#0F172A" />
            </Border.Effect>

            <StackPanel>
                <!-- الشعار والعنوان -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,22">
                    <Border CornerRadius="16" Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2563EB" Offset="0" />
                                <GradientStop Color="#0284C7" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" Direction="270" ShadowDepth="3" Opacity="0.3" Color="#2563EB" />
                        </Border.Effect>
                        <TextBlock Text="💬" FontSize="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="SyncPulse Client" FontSize="22" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" />
                    <TextBlock Text="نظام المراسلة والاتصالات المباشرة" FontSize="12.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>

                <!-- شارة الاكتشاف التلقائي لعنوان الخادم على الواي فاي -->
                <Border Background="#F0FDF4" CornerRadius="8" BorderBrush="#BBF7D0" BorderThickness="1" Padding="10,6" Margin="0,0,0,12">
                    <TextBlock Text="{Binding DiscoveryStatus}" Foreground="#15803D" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                </Border>

                <!-- حقل عنوان السيرفر والمنفذ المكتشفين تلقائياً -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="عنوان الخادم (Server IP):" Foreground="#64748B" FontSize="11" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ServerIP, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1"
                                 Padding="10,7" FontSize="12.5">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="المنفذ:" Foreground="#64748B" FontSize="11" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ServerPort, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1"
                                 Padding="10,7" FontSize="12.5" TextAlignment="Center">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </StackPanel>
                </Grid>

                <!-- عنوان الوضع الحالي (دخول / تسجيل) -->
                <TextBlock Text="{Binding ActionTitle}" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,14" />

                <!-- حقل الاسم الظاهر (يظهر فقط في وضع التسجيل) -->
                <StackPanel Margin="0,0,0,12">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRegisterMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="الاسم الظاهر (Display Name):" Foreground="#475569" FontSize="12" Margin="0,0,0,6" />
                    <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                             Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1"
                             Padding="12,9" FontSize="13">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>

                <!-- حقل اسم المستخدم -->
                <TextBlock Text="اسم المستخدم (@username):" Foreground="#475569" FontSize="12" Margin="0,0,0,6" />
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1"
                         Padding="12,9" FontSize="13" Margin="0,0,0,12">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8" />
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- حقل كلمة المرور -->
                <TextBlock Text="كلمة المرور:" Foreground="#475569" FontSize="12" Margin="0,0,0,6" />
                <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                         Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1"
                         Padding="12,9" FontSize="13" Margin="0,0,0,16">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8" />
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- شريط الخطأ إن وجد -->
                <Border Background="#FEE2E2" CornerRadius="8" BorderBrush="#FECDD3" BorderThickness="1" Padding="10,8" Margin="0,0,0,14">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="11.5" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                </Border>

                <!-- زر الإرسال الأساسي -->
                <Button Content="{Binding ActionTitle}" Command="{Binding SubmitCommand}"
                        Height="44" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand" BorderThickness="0" Margin="0,0,0,12">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2563EB" Offset="0" />
                            <GradientStop Color="#0284C7" Offset="1" />
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Opacity="0.25" Color="#2563EB" />
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- زر التبديل بين الدخول والتسجيل -->
                <Button Content="{Binding SwitchModeText}" Command="{Binding SwitchModeCommand}"
                        Background="Transparent" Foreground="#2563EB" FontWeight="SemiBold" FontSize="12.5" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
