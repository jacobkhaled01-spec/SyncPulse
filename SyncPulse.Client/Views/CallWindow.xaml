<Window x:Class="SyncPulse.Client.Views.CallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📞 مكالمة SyncPulse المباشرة"
        Height="540" Width="420"
        WindowStartupLocation="CenterScreen"
        Background="#0B1120"
        Foreground="White"
        FontFamily="Segoe UI"
        FlowDirection="RightToLeft"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. شارة نوع المكالمة العلوية -->
        <Border Grid.Row="0" HorizontalAlignment="Center" Background="#1E293B" CornerRadius="12" Padding="14,6" BorderBrush="#334155" BorderThickness="1">
            <TextBlock Text="{Binding CallTypeTitle}" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="12.5" />
        </Border>

        <!-- 2. منطقة العرض المباشر (الفيديو الحي أو بطاقة الأفاتار والمؤقت) -->
        <Grid Grid.Row="1" Margin="0,14">
            <!-- أ. شاشة عرض الفيديو الحي (Live Video Stream) -->
            <Border Background="#0F172A" CornerRadius="16" BorderBrush="#334155" BorderThickness="1" ClipToBounds="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasVideoFrame}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <!-- إطار الفيديو المباشر -->
                    <Image Source="{Binding RemoteVideoFrame}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <!-- شارة البث الحي العلوية -->
                    <Border Background="#990F172A" CornerRadius="8" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔴 LIVE" Foreground="#EF4444" FontWeight="Bold" FontSize="10.5" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding DurationText}" Foreground="White" FontWeight="Bold" FontSize="10.5" />
                        </StackPanel>
                    </Border>

                    <!-- اسم الطرف الآخر أسفل الفيديو -->
                    <Border Background="#990F172A" CornerRadius="8" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12">
                        <TextBlock Text="{Binding TargetDisplayName}" Foreground="White" FontWeight="Bold" FontSize="12" />
                    </Border>
                </Grid>
            </Border>

            <!-- ب. بطاقة الأفاتار الافتراضية للمكالمة الصوتية أو جاري الاتصال -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasVideoFrame}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <!-- الأفاتار النابض مع تأثير الهالة الزرقاء -->
                <Border Width="100" Height="100" CornerRadius="50" Margin="0,0,0,16" HorizontalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2563EB" Offset="0" />
                            <GradientStop Color="#0284C7" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" Direction="270" ShadowDepth="4" Opacity="0.45" Color="#2563EB" />
                    </Border.Effect>
                    <TextBlock Text="{Binding InitialChar}" Foreground="White" FontSize="38" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- اسم الطرف الآخر -->
                <TextBlock Text="{Binding TargetDisplayName}" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding DisplayUsername}" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,10" />

                <!-- حالة المكالمة والمؤقت -->
                <TextBlock Text="{Binding StateText}" FontSize="13.5" FontWeight="SemiBold" Foreground="#38BDF8" HorizontalAlignment="Center" />

                <TextBlock Text="{Binding DurationText}" FontSize="17" FontWeight="Bold" Foreground="#4ADE80" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!-- ج. نافذة المعاينة الذاتية لكاميرا المستخدم (Picture-in-Picture PIP) -->
            <Border Width="110" Height="82" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="14"
                    Background="#1E293B" CornerRadius="10" BorderBrush="#38BDF8" BorderThickness="1.5" ClipToBounds="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasLocalVideo}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="3" Opacity="0.5" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Image Source="{Binding LocalVideoFrame}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border Background="#99000000" CornerRadius="4" Padding="4,1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4">
                        <TextBlock Text="أنت 📷" Foreground="White" FontSize="9" FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. أزرار التحكم السفلية -->
        <StackPanel Grid.Row="2">
            <!-- أزرار الرد والرفض عند الرنين الوارد -->
            <Grid Margin="0,0,0,8">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsRinging}" Value="True" />
                                    <Condition Binding="{Binding IsIncoming}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- قبول -->
                <Button Grid.Column="0" Content="رد 📞" Command="{Binding AcceptCommand}"
                        Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="14" Height="44" Margin="0,0,6,0" Cursor="Hand" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10" />
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- رفض -->
                <Button Grid.Column="1" Content="رفض ✕" Command="{Binding RejectCommand}"
                        Background="#EF4444" Foreground="White" FontWeight="Bold" FontSize="14" Height="44" Margin="6,0,0,0" Cursor="Hand" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10" />
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <!-- أدوات التحكم أثناء المكالمة المتصلة أو الصادرة -->
            <StackPanel>
                <!-- تبديل المايك والكاميرا -->
                <UniformGrid Columns="2" Margin="0,0,0,10">
                    <UniformGrid.Style>
                        <Style TargetType="UniformGrid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </UniformGrid.Style>

                    <Button Content="{Binding MuteButtonText}" Command="{Binding ToggleMuteCommand}"
                            Background="#1E293B" Foreground="#F8FAFC" FontSize="11.5" Height="36" Margin="0,0,4,0" Cursor="Hand" BorderBrush="#334155" BorderThickness="1">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Content="{Binding CameraButtonText}" Command="{Binding ToggleCameraCommand}"
                            Background="#1E293B" Foreground="#F8FAFC" FontSize="11.5" Height="36" Margin="4,0,0,0" Cursor="Hand" BorderBrush="#334155" BorderThickness="1">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </UniformGrid>

                <!-- زر إنهاء المكالمة الأحمر -->
                <Button Content="🔴 إنهاء المكالمة" Command="{Binding EndCallCommand}"
                        Background="#E11D48" Foreground="White" FontWeight="Bold" FontSize="13.5" Height="44" Cursor="Hand" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10" />
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
