## .gitignore for .NET / Visual Studio / WPF / C#

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio files
.vs/
.vscode/
*.DotSettings.user
_ReSharper*/

# JetBrains Rider
.idea/

# Database files (temporary local testing DBs)
*.db-shm
*.db-wal

# Windows temporary files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
