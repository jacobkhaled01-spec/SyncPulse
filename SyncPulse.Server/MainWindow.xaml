<Window x:Class="SyncPulse.Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SyncPulse.Server.ViewModels"
        Title="⚡ SyncPulse Enterprise Server | لوحة التحكم المركزية"
        Height="800" Width="1240"
        MinHeight="650" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        Foreground="#0F172A"
        FontFamily="Segoe UI"
        FlowDirection="RightToLeft">

    <Window.DataContext>
        <vm:ServerMainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- بطاقات التصميم الأبيض الحديث النقي مع ظلال ناعمة (Clean White SaaS Cards) -->
        <Style x:Key="ModernWhiteCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" Direction="270" ShadowDepth="3" Opacity="0.06" Color="#0F172A" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- نمط بطاقات الإحصائيات المصغرة (Blue & Ice Metric Badges) -->
        <Style x:Key="MetricPill" TargetType="Border">
            <Setter Property="Background" Value="#F0F7FF" />
            <Setter Property="BorderBrush" Value="#BAE6FD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,10,6" />
        </Style>

        <!-- زر التشغيل الأساسي -->
        <Style x:Key="StartButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#059669" Offset="0" />
                        <GradientStop Color="#10B981" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Opacity="0.25" Color="#10B981" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- زر الإيقاف الأساسي -->
        <Style x:Key="StopButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#E11D48" Offset="0" />
                        <GradientStop Color="#F43F5E" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Opacity="0.25" Color="#E11D48" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- زر الإجراءات الأزرق الملكي -->
        <Style x:Key="RoyalBlueBtn" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2563EB" Offset="0" />
                        <GradientStop Color="#1D4ED8" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Direction="270" ShadowDepth="2" Opacity="0.2" Color="#2563EB" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- تبويبات عصرية باللون الأزرق والأبيض -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" CornerRadius="10,10,0,0" Padding="{TemplateBinding Padding}" Margin="0,0,6,0" BorderThickness="0,0,0,3" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#FFFFFF" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#2563EB" />
                                <Setter Property="Foreground" Value="#1D4ED8" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#0284C7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- نمط ترويسة الجداول الموحد والواضح -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#1E293B" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <!-- نمط خلايا الجداول -->
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderThickness="0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. شريط التحكم والمقاييس العلوي المتجاوب -->
        <Border Grid.Row="0" Style="{StaticResource ModernWhiteCard}" Padding="16,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- الشعار والهوية البصرية -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Border CornerRadius="12" Width="46" Height="46" Margin="0,0,12,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2563EB" Offset="0" />
                                <GradientStop Color="#0284C7" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Opacity="0.25" Color="#2563EB" />
                        </Border.Effect>
                        <TextBlock Text="⚡" FontSize="22" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SyncPulse Server Hub" FontSize="18" FontWeight="Bold" Foreground="#0F172A" />
                        <TextBlock Text="Local TCP &amp; UDP Network Engine" FontSize="11" Foreground="#64748B" />
                    </StackPanel>
                </StackPanel>

                <!-- شريط المقاييس المرن -->
                <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Style="{StaticResource MetricPill}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="الحالة: " Foreground="#475569" FontSize="12" />
                            <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="12" Margin="4,0,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricPill}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🌐 الـ IP: " Foreground="#475569" FontSize="12" />
                            <TextBlock Text="{Binding ServerIP}" Foreground="#0284C7" FontWeight="Bold" FontSize="12" Margin="4,0,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricPill}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👥 المتصلون: " Foreground="#475569" FontSize="12" />
                            <TextBlock Text="{Binding ActiveClientsCount}" Foreground="#059669" FontWeight="Bold" FontSize="12" Margin="4,0,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricPill}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🗄️ المسجلين: " Foreground="#475569" FontSize="12" />
                            <TextBlock Text="{Binding TotalUsersCount}" Foreground="#D97706" FontWeight="Bold" FontSize="12" Margin="4,0,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricPill}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="💬 الرسائل: " Foreground="#475569" FontSize="12" />
                            <TextBlock Text="{Binding TotalMessagesCount}" Foreground="#7C3AED" FontWeight="Bold" FontSize="12" Margin="4,0,0,0" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- أزرار الإدارة والتشغيل -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🔄 تحديث" Command="{Binding RefreshDataCommand}" Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="11" Padding="12,8" Margin="0,0,8,0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="▶ تشغيل" Command="{Binding StartCommand}" Style="{StaticResource StartButton}" Margin="0,0,8,0" />
                    <Button Content="⏹ إيقاف" Command="{Binding StopCommand}" Style="{StaticResource StopButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. منطقة التبويبات المتجاوبة -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            
            <!-- التبويب 1: المراقبة اللحظية وبث الإعلانات -->
            <TabItem Header="📡 المراقبة اللحظية والبث العام">
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6*" MinWidth="350" />
                        <ColumnDefinition Width="4*" MinWidth="280" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- جدول المتصلين -->
                        <Border Grid.Row="0" Style="{StaticResource ModernWhiteCard}" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="👥 الجلسات المتصلة حالياً (Active Sessions)" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10" />

                                <DataGrid Grid.Row="1" ItemsSource="{Binding ConnectedClients}" AutoGenerateColumns="False"
                                          Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#F1F5F9" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC"
                                          Foreground="#1E293B" HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single"
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                          RowHeight="38" FontSize="12">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="المعرف" Binding="{Binding UserID}" Width="70" />
                                        <DataGridTextColumn Header="اسم المستخدم" Binding="{Binding Username}" Width="130" />
                                        <DataGridTextColumn Header="الاسم الظاهر" Binding="{Binding DisplayName}" Width="150" />
                                        <DataGridTextColumn Header="عنوان IP" Binding="{Binding ClientIP}" Width="130" />
                                        <DataGridTextColumn Header="المنفذ" Binding="{Binding ClientPort}" Width="80" />
                                        <DataGridTextColumn Header="وقت الاتصال" Binding="{Binding ConnectedAt, StringFormat='{}{0:HH:mm:ss}'}" Width="100" />
                                        <DataGridTemplateColumn Header="إجراء" Width="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="طرد" Command="{Binding DataContext.KickCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" Background="#FEE2E2" Foreground="#DC2626" BorderBrush="#FECDD3" BorderThickness="1" FontWeight="Bold" FontSize="11" Padding="8,3" Cursor="Hand">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="6" />
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- شريط بث الإشعار العام -->
                        <Border Grid.Row="1" Style="{StaticResource ModernWhiteCard}" Padding="14,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding BroadcastMessageText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="#F8FAFC" Foreground="#0F172A" BorderBrush="#CBD5E1" BorderThickness="1"
                                         Padding="10,8" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBox.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8" />
                                        </Style>
                                    </TextBox.Resources>
                                </TextBox>
                                <Button Grid.Column="1" Content="📢 بث إشعار للجميع" Command="{Binding SendBroadcastCommand}"
                                        Style="{StaticResource RoyalBlueBtn}" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- القسم الأيسر: كونسول سجل الحزم اللحظي -->
                    <Border Grid.Column="1" Style="{StaticResource ModernWhiteCard}" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="📡 سجل تدفق الحزم (Live Stream)" FontSize="13.5" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Content="مسح السجل" Command="{Binding ClearLogsCommand}"
                                        Background="#F1F5F9" Foreground="#64748B" BorderBrush="#CBD5E1" BorderThickness="1" FontSize="11" Padding="10,4" Margin="8,0,0,0" Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6" />
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </Grid>

                            <Border Grid.Row="1" Background="#F0F7FF" CornerRadius="8" BorderBrush="#DBEAFE" BorderThickness="1" Padding="6">
                                <ListBox ItemsSource="{Binding PacketLogs}" Background="Transparent" BorderThickness="0"
                                         Foreground="#1D4ED8" FontFamily="Consolas" FontSize="11.5" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- التبويب 2: إدارة المستخدمين والحظر -->
            <TabItem Header="👥 إدارة الحسابات والحظر">
                <Border Style="{StaticResource ModernWhiteCard}" Padding="18" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="قائمة المستخدمين المسجلين في قاعدة بيانات SQLite المركزية" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12" />

                        <DataGrid Grid.Row="1" ItemsSource="{Binding RegisteredUsers}" AutoGenerateColumns="False"
                                  Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F1F5F9" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC"
                                  Foreground="#1E293B" HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  RowHeight="40" FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="المعرف" Binding="{Binding UserID}" Width="75" />
                                <DataGridTextColumn Header="اسم المستخدم" Binding="{Binding Username}" Width="150" />
                                <DataGridTextColumn Header="الاسم الظاهر" Binding="{Binding DisplayName}" Width="170" />
                                <DataGridTextColumn Header="آخر ظهور" Binding="{Binding LastSeenAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="160" />
                                
                                <DataGridTemplateColumn Header="الحالة" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding IsOnline, Converter={x:Null}}" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="نشط ✓" />
                                                        <Setter Property="Foreground" Value="#059669" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                                <Setter Property="Text" Value="محظور 🚫" />
                                                                <Setter Property="Foreground" Value="#DC2626" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="إجراءات الحساب" Width="230">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="حظر" Command="{Binding DataContext.BanUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" Background="#FEE2E2" Foreground="#DC2626" BorderBrush="#FECDD3" BorderThickness="1" FontSize="11" Padding="8,2" Margin="0,0,6,0" Cursor="Hand" />
                                                <Button Content="فك الحظر" Command="{Binding DataContext.UnbanUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" Background="#D1FAE5" Foreground="#059669" BorderBrush="#A7F3D0" BorderThickness="1" FontSize="11" Padding="8,2" Margin="0,0,6,0" Cursor="Hand" />
                                                <Button Content="تصفير السر" Command="{Binding DataContext.ResetPasswordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}" Background="#DBEAFE" Foreground="#1D4ED8" BorderBrush="#BFDBFE" BorderThickness="1" FontSize="11" Padding="8,2" Cursor="Hand" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- التبويب 3: سجل المكالمات -->
            <TabItem Header="📞 سجل المكالمات (Call History)">
                <Border Style="{StaticResource ModernWhiteCard}" Padding="18" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="سجل المكالمات الصوتية والمرئية المنفذة عبر مكرر UDP Relay" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12" />

                        <DataGrid Grid.Row="1" ItemsSource="{Binding CallHistoryLogs}" AutoGenerateColumns="False"
                                  Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F1F5F9" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC"
                                  Foreground="#1E293B" HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  RowHeight="38" FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="المعرف" Binding="{Binding CallID}" Width="80" />
                                <DataGridTextColumn Header="المتصل" Binding="{Binding CallerUsername}" Width="150" />
                                <DataGridTextColumn Header="المستقبل" Binding="{Binding ReceiverUsername}" Width="150" />
                                <DataGridTextColumn Header="نوع المكالمة" Binding="{Binding CallType}" Width="120" />
                                <DataGridTextColumn Header="المدة (ثواني)" Binding="{Binding DurationSeconds}" Width="120" />
                                <DataGridTextColumn Header="سبب الإنهاء" Binding="{Binding EndReason}" Width="130" />
                                <DataGridTextColumn Header="وقت البدء" Binding="{Binding StartedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="180" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <!-- التبويب 4: سجلات التدقيق والأمان -->
            <TabItem Header="🛡️ سجلات التدقيق والأمان (Audit Logs)">
                <Border Style="{StaticResource ModernWhiteCard}" Padding="18" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="سجلات الأمان والتدقيق اللحظية لأحداث النظام (ISO/IEC 27001 Audit Trail)" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12" />

                        <!-- جدول سجلات التدقيق والأمان المطور والمحكم في العرض -->
                        <DataGrid Grid.Row="1" ItemsSource="{Binding AuditLogsList}" AutoGenerateColumns="False"
                                  Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F1F5F9" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC"
                                  Foreground="#1E293B" HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  MinRowHeight="40" FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="المعرف" Binding="{Binding LogID}" Width="70" />
                                
                                <!-- مستوى الحدث بشارة ملونة متناسقة وواضحة -->
                                <DataGridTemplateColumn Header="المستوى" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#EFF6FF" />
                                                        <Setter Property="BorderBrush" Value="#BFDBFE" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LogLevel}" Value="Warning">
                                                                <Setter Property="Background" Value="#FEF3C7" />
                                                                <Setter Property="BorderBrush" Value="#FDE68A" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding LogLevel}" Value="Error">
                                                                <Setter Property="Background" Value="#FEE2E2" />
                                                                <Setter Property="BorderBrush" Value="#FECDD3" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding LogLevel}" FontWeight="Bold" FontSize="11.5">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#1D4ED8" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LogLevel}" Value="Warning">
                                                                    <Setter Property="Foreground" Value="#B45309" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding LogLevel}" Value="Error">
                                                                    <Setter Property="Foreground" Value="#DC2626" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="المصدر" Binding="{Binding Source}" Width="110" />
                                
                                <!-- نص الرسالة والحدث مع التفاف النص التلقائي والتجاوب الكامل مع حجم المحتوى -->
                                <DataGridTemplateColumn Header="نص الرسالة والحدث والتدقيق" Width="*" MinWidth="300">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="10,6" VerticalAlignment="Center" LineHeight="18" Foreground="#0F172A" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="عنوان IP" Binding="{Binding ClientIP}" Width="130" />
                                <DataGridTextColumn Header="التاريخ والوقت" Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Width="160" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

        </TabControl>

        <!-- 3. الشريط السفلي: شارات المعايير الدولية والبروتوكول -->
        <Border Grid.Row="2" Style="{StaticResource ModernWhiteCard}" Padding="16,8" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="🔒 النواة: SyncPulse.Core" Foreground="#64748B" FontSize="11.5" Margin="0,0,14,0" />
                <TextBlock Text="•" Foreground="#CBD5E1" Margin="0,0,14,0" />
                <TextBlock Text="📦 التأطير: IETF 12-Byte FrameHeader" Foreground="#64748B" FontSize="11.5" Margin="0,0,14,0" />
                <TextBlock Text="•" Foreground="#CBD5E1" Margin="0,0,14,0" />
                <TextBlock Text="💾 قاعدة البيانات: SQLite 3NF (WAL Mode)" Foreground="#64748B" FontSize="11.5" Margin="0,0,14,0" />
                <TextBlock Text="•" Foreground="#CBD5E1" Margin="0,0,14,0" />
                <TextBlock Text="⚡ المنافذ: TCP 8888, UDP 8889, UDP 8887" Foreground="#1D4ED8" FontWeight="SemiBold" FontSize="11.5" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
