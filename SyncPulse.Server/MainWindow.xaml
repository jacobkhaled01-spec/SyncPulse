<Window x:Class="SyncPulse.Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SyncPulse.Server.ViewModels"
        Title="⚡ SyncPulse Enterprise Server | لوحة التحكم المركزية"
        Height="760" Width="1180"
        MinHeight="680" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F19"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI"
        FlowDirection="RightToLeft">

    <Window.DataContext>
        <vm:ServerMainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- أنماط البطاقات الفاخرة (Glassmorphism & Card Styles) -->
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="#151D2E" />
            <Setter Property="BorderBrush" Value="#26334D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" Direction="270" ShadowDepth="4" Opacity="0.35" Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- نمط الأزرار الحديثة بتأثير التمرير والظلال -->
        <Style x:Key="PrimaryStartBtn" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#059669" Offset="0" />
                        <GradientStop Color="#10B981" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Opacity="0.4" Color="#10B981" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryStopBtn" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#E11D48" Offset="0" />
                        <GradientStop Color="#F43F5E" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Opacity="0.4" Color="#E11D48" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- تخصيص شريط التمرير -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Width" Value="8" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. شريط التحكم العلوي والمقاييس اللحظية (Top Header & Metric Badges) -->
        <Border Grid.Row="0" Style="{StaticResource ModernCard}" Padding="18,14" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- شعار النظام واسم الخادم -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <Border CornerRadius="12" Width="48" Height="48" Margin="0,0,14,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6366F1" Offset="0" />
                                <GradientStop Color="#06B6D4" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="⚡" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SyncPulse Enterprise" FontSize="19" FontWeight="Bold" Foreground="#F8FAFC" />
                        <TextBlock Text="Local TCP &amp; UDP High-Performance Hub" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- بطاقات المقاييس والإحصائيات الحية -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- بطاقة الحالة -->
                    <Border Background="#101827" CornerRadius="10" Padding="14,8" Margin="0,0,12,0" BorderBrush="#1E293B" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="الحالة: " Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusText}" FontWeight="Bold" FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- بطاقة عنوان IP -->
                    <Border Background="#101827" CornerRadius="10" Padding="14,8" Margin="0,0,12,0" BorderBrush="#1E293B" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🌐 الـ IP المحلي: " Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ServerIP}" Foreground="#38BDF8" FontWeight="Bold" FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- بطاقة المنفذ -->
                    <Border Background="#101827" CornerRadius="10" Padding="14,8" Margin="0,0,12,0" BorderBrush="#1E293B" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔌 المنفذ: " Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ServerPort}" Foreground="#818CF8" FontWeight="Bold" FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- بطاقة عدد المتصلين -->
                    <Border Background="#101827" CornerRadius="10" Padding="14,8" BorderBrush="#1E293B" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👥 المتصلون: " Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ActiveClientsCount}" Foreground="#4ADE80" FontWeight="Bold" FontSize="13" Margin="4,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- أزرار الإدارة -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="▶ تشغيل الخادم" Command="{Binding StartCommand}" Style="{StaticResource PrimaryStartBtn}" Margin="0,0,10,0" />
                    <Button Content="⏹ إيقاف الخادم" Command="{Binding StopCommand}" Style="{StaticResource PrimaryStopBtn}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. منطقة العمل الرئيسية: جدول المتصلين + سجل الحزم اللحظي -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6.2*" />
                <ColumnDefinition Width="3.8*" />
            </Grid.ColumnDefinitions>

            <!-- القسم الأيمن: جدول المتصلين النشطين -->
            <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="18" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1E293B" CornerRadius="6" Width="26" Height="26" Margin="0,0,8,0">
                                <TextBlock Text="👥" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="الجلسات المتصلة حالياً (Active Client Sessions)" FontSize="15" FontWeight="Bold" Foreground="#F1F5F9" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding ConnectedClients}" AutoGenerateColumns="False"
                              Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#1E293B" RowBackground="Transparent" AlternatingRowBackground="#0E1524"
                              Foreground="#F8FAFC" HeadersVisibility="Column" CanUserAddRows="False" SelectionMode="Single"
                              RowHeight="40" FontSize="12">
                        
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#0F172A" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                                <Setter Property="Padding" Value="10,10" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="#334155" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="المعرف" Binding="{Binding UserID}" Width="65" />
                            <DataGridTextColumn Header="اسم المستخدم" Binding="{Binding Username}" Width="120" />
                            <DataGridTextColumn Header="الاسم الظاهر" Binding="{Binding DisplayName}" Width="140" />
                            <DataGridTextColumn Header="عنوان IP" Binding="{Binding ClientIP}" Width="125" />
                            <DataGridTextColumn Header="المنفذ" Binding="{Binding ClientPort}" Width="75" />
                            <DataGridTextColumn Header="وقت الاتصال" Binding="{Binding ConnectedAt, StringFormat='{}{0:HH:mm:ss}'}" Width="95" />
                            
                            <DataGridTemplateColumn Header="إجراء" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="طرد"
                                                Command="{Binding DataContext.KickCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Background="#EF4444" Foreground="White" FontWeight="Bold" FontSize="11"
                                                Padding="10,4" BorderThickness="0" Cursor="Hand">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6" />
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- القسم الأيسر: كونسول سجل الحزم والنشاط اللحظي -->
            <Border Grid.Column="1" Style="{StaticResource ModernCard}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#1E293B" CornerRadius="6" Width="26" Height="26" Margin="0,0,8,0">
                                <TextBlock Text="📡" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="سجل تدفق الحزم (Live Stream)" FontSize="15" FontWeight="Bold" Foreground="#F1F5F9" VerticalAlignment="Center" />
                        </StackPanel>

                        <Button Content="مسح السجل" Command="{Binding ClearLogsCommand}" HorizontalAlignment="Left"
                                Background="#1E293B" Foreground="#94A3B8" FontSize="11" Padding="12,5" BorderBrush="#334155" BorderThickness="1" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6" />
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <!-- شاشة الكونسول السوداء المتطورة -->
                    <Border Grid.Row="1" Background="#060911" CornerRadius="10" BorderBrush="#1E293B" BorderThickness="1" Padding="6">
                        <ListBox ItemsSource="{Binding PacketLogs}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="#38BDF8" FontFamily="Consolas" FontSize="11.5">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="4,2" />
                                    <Setter Property="Margin" Value="0,1" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4">
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#111A2E" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. الشريط السفلي: شارات البروتوكول والمعايير -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}" Padding="16,8" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="🔒 النواة: SyncPulse.Core" Foreground="#64748B" FontSize="11.5" Margin="0,0,14,0" />
                <TextBlock Text="•" Foreground="#334155" Margin="0,0,14,0" />
                <TextBlock Text="📦 التأطير: IETF 12-Byte FrameHeader" Foreground="#64748B" FontSize="11.5" Margin="0,0,14,0" />
                <TextBlock Text="•" Foreground="#334155" Margin="0,0,14,0" />
                <TextBlock Text="💾 قاعدة البيانات: SQLite 3NF (WAL Enabled)" Foreground="#64748B" FontSize="11.5" Margin="0,0,14,0" />
                <TextBlock Text="•" Foreground="#334155" Margin="0,0,14,0" />
                <TextBlock Text="⚡ المنافذ: TCP 8888 (Control), UDP 8889 (Media Relay), UDP 8887 (Discovery)" Foreground="#0EA5E9" FontWeight="SemiBold" FontSize="11.5" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
